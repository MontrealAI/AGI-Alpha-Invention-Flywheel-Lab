+// Opt-in partial terminal list. This is not a complete top-K or coset enumeration.
+struct ErrorCandidate {
+  std::vector<size_t> errors;  // Original flattened DEM IDs.
+  double cost = 0;
+  std::vector<int> observables;
+};
+
+struct CandidateListResult {
+  std::vector<ErrorCandidate> candidates;
+  size_t pushed = 0;
+  size_t popped = 0;
+  size_t expanded = 0;
+  size_t max_queue = 0;
+  size_t max_arena = 0;
+  size_t raw_goals = 0;
+  size_t duplicate_goals = 0;
+  std::string stop_reason;
+  bool truncated = true;  // Even exhaustion only covers the detector-driven search.
+  double first_goal_seconds = -1;
+  double elapsed_seconds = 0;
+};
+
