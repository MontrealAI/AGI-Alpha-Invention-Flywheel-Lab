+CandidateListResult TesseractDecoder::decode_to_error_candidates(
+    const std::vector<uint64_t>& detections, size_t detector_order_index,
+    size_t detector_beam, size_t max_unique_goals) {
+  if (config.no_revisit_dets) {
+    throw std::invalid_argument("Candidate lists require no_revisit_dets=false.");
+  }
+  if (max_unique_goals == 0 || max_unique_goals > 64) {
+    throw std::invalid_argument("max_unique_goals must be between 1 and 64.");
+  }
+  if (config.pqlimit == 0 || config.pqlimit == std::numeric_limits<size_t>::max()) {
+    throw std::invalid_argument("Candidate lists require a finite positive pqlimit.");
+  }
+  if (config.sparsify_errors) build_sparse_d2e(detections);
+  const auto& active_d2e = config.sparsify_errors ? sparse_d2e : d2e;
+  CandidateListResult result;
+  decode_to_errors_with_graph(detections, detector_order_index, detector_beam,
+                             active_d2e, &result, max_unique_goals);
+  return result;
+}
