diff --git a/src/tesseract.test.cc b/src/tesseract.test.cc
index 1154958..b35be9d 100644
--- a/src/tesseract.test.cc
+++ b/src/tesseract.test.cc
@@ -1172,5 +1172,138 @@ TEST(utils, GariSourcePrefixB8Decodes) {
   EXPECT_EQ(simplex.decode(shots[1].hits), (std::vector<int>{1}));
 }
 
+
+TEST(TesseractCandidateList, MultipleClassesAndFirstGoalCompatibility) {
+  stim::DetectorErrorModel dem(R"DEM(
+    error(0.1) D0
+    error(0.08) D0 L0
+    error(0.05) D0 L1
+  )DEM");
+  TesseractConfig config{dem};
+  config.no_revisit_dets = false;
+  TesseractDecoder decoder(config);
+  decoder.decode_to_errors({0}, 0, 5);
+  auto original = decoder.predicted_errors_buffer;
+  auto original_cost = decoder.cost_from_errors(original);
+  auto one = decoder.decode_to_error_candidates({0}, 0, 5, 1);
+  ASSERT_EQ(one.candidates.size(), 1);
+  EXPECT_DOUBLE_EQ(one.candidates[0].cost, original_cost);
+  EXPECT_EQ(one.candidates[0].observables, decoder.get_flipped_observables(original));
+  EXPECT_EQ(one.stop_reason, "goal_limit");
+  auto list = decoder.decode_to_error_candidates({0}, 0, 5);
+  ASSERT_EQ(list.candidates.size(), 3);
+  EXPECT_EQ(list.stop_reason, "queue_exhausted");
+  EXPECT_TRUE(list.truncated);
+  EXPECT_FALSE(decoder.low_confidence_flag);
+  EXPECT_EQ(list.pushed, 4);
+  EXPECT_EQ(list.popped, 4);
+  EXPECT_EQ(list.expanded, 1);
+  EXPECT_EQ(list.max_queue, 3);
+  EXPECT_EQ(list.max_arena, 3);
+  EXPECT_EQ(list.raw_goals, 3);
+  EXPECT_EQ(list.duplicate_goals, 0);
+  EXPECT_GE(list.first_goal_seconds, 0);
+  EXPECT_GE(list.elapsed_seconds, list.first_goal_seconds);
+  for (const auto& candidate : list.candidates) {
+    ASSERT_EQ(candidate.errors.size(), 1);
+    EXPECT_DOUBLE_EQ(candidate.cost, decoder.cost_from_errors(candidate.errors));
+    EXPECT_EQ(candidate.observables, decoder.get_flipped_observables(candidate.errors));
+  }
+}
+
+TEST(TesseractCandidateList, SameClassConfigurationsAreNotMerged) {
+  stim::DetectorErrorModel dem(R"DEM(
+    error(0.1) D0
+    error(0.08) D0 D1
+    error(0.07) D1
+    error(0.05) D0 L0
+  )DEM");
+  TesseractConfig config{dem};
+  config.no_revisit_dets = false;
+  TesseractDecoder decoder(config);
+  auto list = decoder.decode_to_error_candidates({0}, 0, 5);
+  size_t class_zero = 0;
+  size_t class_one = 0;
+  for (const auto& candidate : list.candidates) {
+    class_zero += candidate.observables.empty();
+    class_one += candidate.observables == std::vector<int>{0};
+  }
+  EXPECT_GE(class_zero, 2);
+  EXPECT_GE(class_one, 1);
+  EXPECT_EQ(list.raw_goals, list.candidates.size() + list.duplicate_goals);
+}
+
+TEST(TesseractCandidateList, MergedOriginalIdsAndCorrelatedSeparator) {
+  stim::DetectorErrorModel dem(R"DEM(
+    error(0.1) D0 D1 ^ D1 L0
+    error(0.2) D0 L0
+    error(0) D3 L2
+    error(0.05) D0 L1
+  )DEM");
+  TesseractConfig config{dem};
+  config.no_revisit_dets = false;
+  TesseractDecoder decoder(config);
+  auto list = decoder.decode_to_error_candidates({0}, 0, 5);
+  ASSERT_EQ(list.candidates.size(), 2);
+  for (const auto& candidate : list.candidates) {
+    ASSERT_EQ(candidate.errors.size(), 1);
+    EXPECT_NE(candidate.errors[0], 2);  // Removed zero-probability error.
+    EXPECT_DOUBLE_EQ(candidate.cost, decoder.cost_from_errors(candidate.errors));
+    EXPECT_EQ(candidate.observables, decoder.get_flipped_observables(candidate.errors));
+    EXPECT_TRUE(candidate.observables == std::vector<int>{0} ||
+                candidate.observables == std::vector<int>{1});
+  }
+}
+
+TEST(TesseractCandidateList, EmptySyndromeAndNoGoalStatus) {
+  stim::DetectorErrorModel dem("error(0.1) D0\ndetector D1");
+  TesseractConfig config{dem};
+  config.no_revisit_dets = false;
+  TesseractDecoder decoder(config);
+  auto empty = decoder.decode_to_error_candidates({}, 0, 5);
+  ASSERT_EQ(empty.candidates.size(), 1);
+  EXPECT_TRUE(empty.candidates[0].errors.empty());
+  EXPECT_DOUBLE_EQ(empty.candidates[0].cost, 0);
+  EXPECT_TRUE(empty.truncated);  // Disconnected cycles are not enumerated.
+  EXPECT_FALSE(decoder.low_confidence_flag);
+  auto impossible = decoder.decode_to_error_candidates({1}, 0, 5);
+  EXPECT_TRUE(impossible.candidates.empty());
+  EXPECT_EQ(impossible.stop_reason, "initial_infinite_cost");
+  EXPECT_TRUE(decoder.low_confidence_flag);
+}
+
+TEST(TesseractCandidateList, RejectsIncompatibleConfigurationAndKeepsCapConvention) {
+  stim::DetectorErrorModel dem("error(0.1) D0\nerror(0.05) D0 L0");
+  TesseractConfig config{dem};
+  TesseractDecoder default_decoder(config);
+  EXPECT_THROW(default_decoder.decode_to_error_candidates({0}, 0, 5), std::invalid_argument);
+  config.no_revisit_dets = false;
+  config.pqlimit = 1;
+  TesseractDecoder decoder(config);
+  auto capped = decoder.decode_to_error_candidates({0}, 0, 5);
+  EXPECT_TRUE(capped.candidates.empty());
+  EXPECT_EQ(capped.stop_reason, "push_limit");
+  EXPECT_EQ(capped.pushed, 2);  // Existing P+1 convention, not queue length.
+  EXPECT_EQ(capped.max_arena, 1);
+  EXPECT_TRUE(decoder.low_confidence_flag);
+  EXPECT_THROW(decoder.decode_to_error_candidates({0}, 0, 5, 0), std::invalid_argument);
+  EXPECT_THROW(decoder.decode_to_error_candidates({0}, 0, 5, 65), std::invalid_argument);
+}
+
+TEST(TesseractCandidateList, CapAfterFirstGoalRetainsValidPrediction) {
+  stim::DetectorErrorModel dem("error(0.4) D0\nerror(0.05) D0 D1\nerror(0.1) D1");
+  TesseractConfig config{dem};
+  config.no_revisit_dets = false;
+  config.pqlimit = 3;
+  TesseractDecoder decoder(config);
+  auto list = decoder.decode_to_error_candidates({0}, 0, 5);
+  ASSERT_EQ(list.candidates.size(), 1);
+  EXPECT_EQ(list.stop_reason, "push_limit");
+  EXPECT_EQ(list.pushed, 4);
+  EXPECT_EQ(decoder.predicted_errors_buffer, list.candidates[0].errors);
+  EXPECT_FALSE(decoder.low_confidence_flag);
+  EXPECT_TRUE(list.truncated);
+}
