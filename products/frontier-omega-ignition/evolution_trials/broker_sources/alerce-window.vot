<VOTABLE version="1.5" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://vo.ari.uni-heidelberg.de/docs/schemata/VOTable.xsd"><RESOURCE type="results"><INFO name="sql_query" value="SELECT d.oid, d.candid, d.mjd, d.fid, d.rfid, d.pid FROM ztf.detection AS d WHERE d.oid = 'ZTF26acbezdh' AND d.fid IN ( 1 , 2 ) AND ( ( d.mjd &gt;= 61339 AND d.mjd &lt; 61342 ) OR d.candid IN ( 3579392285815015017 , 3584356425815015004 , 3580268845815015008 , 3584382785815015006 ) ) ORDER BY d.mjd , d.candid LIMIT 1000">ADQL query translated to local SQL (for debugging)</INFO><INFO name="query" value="SELECT d.oid, d.candid, d.mjd, d.fid, d.rfid, d.pid FROM ztf.detection AS d WHERE d.oid='ZTF26acbezdh' AND d.fid IN (1,2) AND ((d.mjd&gt;=61339 AND d.mjd&lt;61342) OR d.candid IN (3579392285815015017,3584356425815015004,3580268845815015008,3584382785815015006)) ORDER BY d.mjd, d.candid">Original ADQL query</INFO><INFO name="QUERY_STATUS" value="OK">Query successful</INFO><INFO name="server_software" value="DaCHS/2.11 twistedWeb/24.11.0">Software that produced this VOTable</INFO><INFO name="server" value="https://tap.alerce.online">Base URI of the server</INFO><INFO name="citation" ucd="" value="https://tap.alerce.online/__system__/tap/run/howtocite">Advice on citing this resource</INFO><INFO name="citation" ucd="" value="https://tap.alerce.online/tableinfo/ztf.detection#ti-citing">Advice on citing this resource</INFO><INFO name="ivoid" ucd="meta.ref.ivoid" value="ivo://x-unregistred/ztf/ztf_lowercase/d">Originating VO resource</INFO><INFO name="publisher" value="ALeRCE (Automatic Learning for the Rapid Classification of Events)">Data centre that has delivered the data</INFO><INFO name="request_date" ucd="time.creation" value="2026-11-18T04:25:27Z"></INFO><INFO name="contact" ucd="meta.email" value="alerce.broker@gmail.com">Contact option</INFO><INFO name="reference_url" ucd="meta.r