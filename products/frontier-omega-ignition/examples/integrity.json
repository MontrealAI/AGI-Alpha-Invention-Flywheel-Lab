{
  "id": "integrity",
  "title": "Inspect a research release",
  "mission": {
    "purpose": "Let a MONTREAL.AI release reviewer verify the exact received IGNITION styles against a pinned two-file manifest, offline, and distinguish changed, missing and unexpected files.",
    "beneficiary": "MONTREAL.AI release reviewer",
    "requirements": [
      "Report matched, changed, missing and unexpected file names from observed bytes.",
      "Reject malformed base64 and unsafe names."
    ],
    "authority": {
      "local_model": true,
      "assisted_model": true,
      "public_sources": false
    },
    "resources": {
      "assets": "Included public evidence and local standard-library interpreter",
      "budget": "No purchases or new paid services"
    },
    "time": {
      "as_of": "2026-11-17",
      "baseline": "2026-10-13"
    },
    "construction_spec": {
      "kind": "manifest_audit",
      "purpose": "Let a MONTREAL.AI release reviewer verify the exact received IGNITION styles against a pinned two-file manifest, offline, and distinguish changed, missing and unexpected files.",
      "definition": {
        "manifest": {
          "ignition.css": "23675652f7ffa6fbdbd0d085580ef56687f731e9066e28e1f6a5ad0c449b8668",
          "studio.css": "13ef0db945f190ede9f03078601d9173b925c8c1b6802f0c0b69b636ca593fc8"
        }
      },
      "cases": [
        {
          "name": "Clean receipt for both real source blobs",
          "input": {
            "files": {
              "ignition.css": "",
              "studio.css": ""
            }
          },
          "expected": {
            "ok": true,
            "matched": [
              "ignition.css",
              "studio.css"
            ],
            "changed": [],
            "missing": [],
            "unexpected": []
          }
        },
        {
          "name": "A one-byte replacement, an omission and an extra file",
          "input": {
            "files": {
              "ignition.css": "",
              "extra.css": "Lygp"
            }
          },
          "expected": {
            "ok": false,
            "matched": [],
            "changed": [
              "ignition.css"
            ],
            "missing": [
              "studio.css"
            ],
            "unexpected": [
              "extra.css"
            ]
          }
        },
        {
          "name": "No files delivered",
          "input": {
            "files": {}
          },
          "expected": {
            "ok": false,
            "matched": [],
            "changed": [],
            "missing": [
              "ignition.css",
              "studio.css"
            ],
            "unexpected": []
          }
        },
        {
          "name": "Malformed base64",
          "input": {
            "files": {
              "ignition.css": "???"
            }
          },
          "error": "invalid_value"
        },
        {
          "name": "Unsafe observed name",
          "input": {
            "files": {
              "../styles.css": "YQ=="
            }
          },
          "error": "invalid_path"
        }
      ]
    }
  },
