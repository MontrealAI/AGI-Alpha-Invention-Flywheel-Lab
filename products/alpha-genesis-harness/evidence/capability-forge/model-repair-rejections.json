  "model_sources": {
    "candidate-001.txt": "import itertools\nfrom fractions import Fraction\nfrom math import gcd\nfrom collections import defaultdict\n\ndef solve(data):\n    A = data['A']\n    y = data['y']\n    target = data['target']\n    faults = data['faults']\n    \n    n = len(A)\n    m = len(target)\n    \n    # Generate all possible subsets of rows with at most 'faults' faults\n    from itertools import combinations\n    valid_subsets = []\n    for r in range(faults + 1):\n        for subset in combinations(range(n), r):\n            valid_subsets.append(subset)\n    \n    results = []\n    for subset in valid_subsets:\n        # Build system with only non-faulty rows\n        A_sub = [A[i] for i in subset]\n        y_sub = [y[i] for i in subset]\n        if len(A_sub) == 0:\n            continue\n        # Solve A_sub @ x = y_sub\n        try:\n            sol = rational_affine(A_sub, y_sub, m)\n            if sol is None:\n                continue\n            x_sol = sol[0]\n            null_space = sol[1]\n            # Compute target @ x\n            val = sum(target[i] * x_sol[i] for i in range(m))\n            # Check if null space introduces variation\n            if null_space:\n                # Try perturbations in null space\n                for null_vec in null_space:\n                    if any(abs(null_vec[i]) > 1e-9 for i in range(m)):\n                        # Check if perturbation changes target·x\n                        new_val = val + sum(target[i] * null_vec[i] for i in range(m))\n                        if abs(new_val - val) > 1e-9:\n                            return {\"status\": \"ambiguous\"}\n            results.append(val)\n        except:\n            continue\n    \n    if not results:\n        return {\"status\": \"inconsistent\"}\n    if len(set(results)) > 1:\n        return {\"status\": \"ambiguous\"}\n    return {\"status\": \"determined\", \"value\": str(results[0]).replace('1/', '1/').replace('0/', '0/')}\n",
    "candidate-002.txt": "from itertools import combinations\nfrom fractions import Fraction\nfrom math import gcd\nfrom functools import reduce\n\ndef solve(data):\n    A = data['A']\n    y = data['y']\n    target = data['target']\n    faults = data['faults']\n    \n    n = len(A)\n    m = len(target)\n    \n    def solve_system(subset):\n        if not subset:\n            return None\n        A_sub = [A[i] for i in subset]\n        y_sub = [y[i] for i in subset]\n        if not A_sub:\n            return None\n        # Use rational_affine to solve\n        sol = rational_affine(A_sub, y_sub, m)\n        if sol is None:\n            return None\n        x_sol = sol[0]\n        null_space = sol[1]\n        val = sum(target[i] * x_sol[i] for i in range(m))\n        if null_space:\n            for vec in null_space:\n                if any(abs(vec[i]) > 1e-9 for i in range(m)):\n                    new_val = val + sum(target[i] * vec[i] for i in range(m))\n                    if abs(new_val - val) > 1e-9:\n                        return None\n        return val\n    \n    results = []\n    for r in range(faults + 1):\n        for subset in combinations(range(n), r):\n            res = solve_system(subset)\n            if res is not None:\n                results.append(res)\n    \n    if not results:\n        return {\"status\": \"inconsistent\"}\n    if len(set(results)) > 1:\n        return {\"status\": \"ambiguous\"}\n    return {\"status\": \"determined\", \"value\": str(results[0])}\n"
  },
