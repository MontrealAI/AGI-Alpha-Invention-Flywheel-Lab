{"created": "2018-05-28T08:39:48.570659+00:00", "modified": "2024-08-02T15:45:57.192380+00:00", "id": 1254206, "conceptrecid": "1254205", "doi": "10.5281/zenodo.1254206", "conceptdoi": "10.5281/zenodo.1254205", "doi_url": "https://doi.org/10.5281/zenodo.1254206", "metadata": {"title": "Tomographic X-ray data of a walnut", "doi": "10.5281/zenodo.1254206", "publication_date": "2015-02-11", "description": "<p>This is an open-access dataset of tomographic X-ray data of a walnut. The dataset consists of the X-ray sinogram of a single 2D slice of the walnut with three different resolutions and the corresponding measurement matrices modeling the linear operation of the X-ray transform. Each of these sinograms was obtained from a measured 120-projection fan-beam sinogram by down-sampling and taking logarithms. The original (measured) sinogram is also provided in its original form and resolution.</p>\n\n<p>In addition, a larger set of 1200 projections of the same walnut was measured and a high-resolution filtered back-projection reconstruction was computed from this data; both the sinogram and the FBP reconstruction are included in the dataset, the latter serving as a ground truth reconstruction.</p>\n\n<p>Documentation of the dataset is available at <a href=\"https://arxiv.org/abs/1502.04064\">arxiv.org/abs/1502.04064</a>. See also <a href=\"https://www.fips.fi/dataset.php\">www.fips.fi/dataset.php</a>.</p>", "access_right": "open", "creators": [{"name": "H\u00e4m\u00e4l\u00e4inen, Keijo", "affiliation": "University of Helsinki"}, {"name": "Harhanen, Lauri", "affiliation": "Aalto University"}, {"name": "Kallonen, Aki", "affiliation": "University of Helsinki"}, {"name": "Kujanp\u00e4\u00e4, Antti", "affiliation": "University of Helsinki"}, {"name": "Niemi, Esa", "affiliation": "University of Helsinki"}, {"name": "Siltanen, Samuli", "affiliation": "University of Helsinki"}], "keywords": ["X-ray", "Radon transform", "inverse problem"], "related_identifiers": [{"identifier": "https://arxiv.org/abs/1502.04064", "relation": "isDocumentedBy", "scheme": "url"}], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "fips"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1254205"}}]}}, "title": "Tomographic X-ray data of a walnut", "links": {"self": "https://zenodo.org/api/records/1254206", "self_html": "https://zenodo.org/records/1254206", "preview_html": "https://zenodo.org/records/1254206?preview=1", "doi": "https://doi.org/10.5281/zenodo.1254206", "self_doi": "https://doi.org/10.5281/zenodo.1254206", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1254206", "reserve_doi": "https://zenodo.org/api/records/1254206/draft/pids/doi", "parent": "https://zenodo.org/api/records/1254205", "parent_html": "https://zenodo.org/records/1254205", "parent_doi": "https://doi.org/10.5281/zenodo.1254205", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.1254205", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:1254206/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:1254206/sequence/default", "files": "https://zenodo.org/api/records/1254206/files", "media_files": "https://zenodo.org/api/records/1254206/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:1254206:Documentation_v1.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:1254206:Documentation_v1.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:1254206:Documentation_v1.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:1254206:Documentation_v1.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:1254206:Documentation_v1.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:1254206:Documentation_v1.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/reco