{
  "name": "Frontier Conclave Omega.001 proposal acceptance checker",
  "inputs": [
    "cap_a",
    "cap_b",
    "cap_c",
    "a",
    "b",
    "c",
    "cost",
    "contingency",
    "consent_a",
    "consent_b",
    "consent_c"
  ],
  "bindings": {
    "total": {
      "formula": "a + b + c"
    },
    "required": {
      "formula": "cost + contingency"
    },
    "caps_ok": {
      "formula": "a <= cap_a and b <= cap_b and c <= cap_c"
    },
    "consent_ok": {
      "formula": "consent_a and consent_b and consent_c"
    },
    "nonnegative": {
      "formula": "cap_a >= 0 and cap_b >= 0 and cap_c >= 0 and a >= 0 and b >= 0 and c >= 0 and cost >= 0 and contingency >= 0"
    }
  },
  "outputs": {
    "total": {
      "formula": "total"
    },
    "required": {
      "formula": "required"
    },
    "gap": {
      "formula": "max(0, required - total)"
    },
    "surplus": {
      "formula": "max(0, total - required)"
    },
    "within_caps": {
      "formula": "caps_ok"
    },
    "all_consent": {
      "formula": "consent_ok"
    },
    "accepted": {
      "formula": "total >= required"
    },
    "capacity_sufficient": {
      "formula": "cap_a + cap_b + cap_c >= required"
    }
  }
}
