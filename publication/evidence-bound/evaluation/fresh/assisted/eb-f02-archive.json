    "audited_calculation.json": "{\"evaluator_sha256\":\"48d0ab154a4fd5d09f8edc7b65dbcb916c7967d68c78901bdeb3c949a534084d\",\"schema\":\"frontier/bounded-table-instrument-v1\",\"sql\":\"WITH latest AS (\\n  SELECT l.* FROM ledger AS l\\n  WHERE l.revision = (SELECT MAX(prior.revision) FROM ledger AS prior WHERE prior.lane = l.lane)\\n), totals AS (\\n  SELECT SUM(accepted) AS good, SUM(attempts) AS total FROM latest\\n  WHERE state = 'active' HAVING SUM(attempts) > 0 AND SUM(accepted) BETWEEN 0 AND SUM(attempts)\\n)\\nSELECT CAST(good AS TEXT) || '/' || CAST(total AS TEXT), good, total\\nFROM totals\",\"table_schema\":{\"ledger\":{\"accepted\":\"INTEGER\",\"attempts\":\"INTEGER\",\"lane\":\"TEXT\",\"revision\":\"INTEGER\",\"state\":\"TEXT\"}}}"
