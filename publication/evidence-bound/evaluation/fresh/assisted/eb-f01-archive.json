    "audited_calculation.json": "{\"evaluator_sha256\":\"48d0ab154a4fd5d09f8edc7b65dbcb916c7967d68c78901bdeb3c949a534084d\",\"schema\":\"frontier/bounded-table-instrument-v1\",\"sql\":\"WITH normalized AS (\\n  SELECT CASE volume_unit WHEN 'mL' THEN volume WHEN 'dL' THEN volume * 100 WHEN 'L' THEN volume * 1000 END AS ml,\\n         CASE concentration_unit WHEN 'mg/L' THEN concentration WHEN 'ug/mL' THEN concentration WHEN 'g/L' THEN concentration * 1000 END AS mg_l\\n  FROM batches\\n), totals AS (\\n  SELECT SUM(ml) AS volume_n, SUM(ml * mg_l) AS mass_n\\n  FROM normalized HAVING COUNT(ml) = COUNT(*) AND COUNT(mg_l) = COUNT(*) AND SUM(ml) > 0\\n)\\nSELECT CAST(mass_n AS TEXT) || '/' || CAST(volume_n AS TEXT),\\n       CAST(mass_n AS TEXT) || '/1000', CAST(volume_n AS TEXT) || '/1000'\\nFROM totals\",\"table_schema\":{\"batches\":{\"concentration\":\"INTEGER\",\"concentration_unit\":\"TEXT\",\"lot\":\"TEXT\",\"volume\":\"INTEGER\",\"volume_unit\":\"TEXT\"}}}"
  },
