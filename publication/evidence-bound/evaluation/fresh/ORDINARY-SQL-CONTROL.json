        "sql": "WITH latest AS (\n  SELECT l.* FROM ledger AS l\n  WHERE l.revision = (SELECT MAX(prior.revision) FROM ledger AS prior WHERE prior.lane = l.lane)\n), totals AS (\n  SELECT SUM(accepted) AS good, SUM(attempts) AS total FROM latest\n  WHERE state = 'active' HAVING SUM(attempts) > 0 AND SUM(accepted) BETWEEN 0 AND SUM(attempts)\n)\nSELECT CAST(good AS TEXT) || '/' || CAST(total AS TEXT), good, total\nFROM totals",
